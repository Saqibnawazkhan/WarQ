{
  "name": "@warq/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Warq worker — scheduled subscription transitions, expiry reminders, absence alerts and PDF reports.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@warq/core": "*",
    "fastify": "5.11.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.11"
  }
}
