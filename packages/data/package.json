{
  "name": "@warq/data",
  "version": "0.1.0",
  "private": true,
  "description": "Typed Supabase access for Warq. One client factory, one set of row types, shared by web, mobile and the worker.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2",
    "@warq/core": "*"
  }
}
