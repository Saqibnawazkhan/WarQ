<?xml version="1.0" encoding="utf-8"?>
<!-- The launch frame for API 21 and up, which is every device that runs this.
     Deliberately white in both light and dark mode: the wordmark is dark navy
     and disappears entirely against ?android:colorBackground once the system is
     in dark mode. A brief white frame is better than a logo nobody can see. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
