<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 and later crop the icon to whatever shape the launcher uses - a
     circle, a squircle, a rounded square - so the mark is supplied on its own
     transparent layer and the ground is a flat colour behind it. The mark is
     drawn well inside the safe zone in ic_launcher_foreground.png, because only
     the middle two thirds of an adaptive icon is guaranteed to survive the
     crop. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
