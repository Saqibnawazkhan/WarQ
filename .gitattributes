# Normalise line endings so Windows and CI agree.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Design mockups are generated artefacts — keep them out of diffs and language stats.
design/** linguist-vendored
design/** -diff
