{
  "name": "warq",
  "version": "0.1.0",
  "private": true,
  "description": "Warq — education management SaaS for teachers, organizations and platform administrators.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Saqibnawazkhan/WarQ.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf node_modules",
    "db:link": "supabase link --project-ref umkyvmnadjturrsdubfm",
    "db:push": "supabase db push --linked",
    "db:push:dry": "supabase db push --linked --dry-run",
    "db:seed": "supabase db push --linked --include-seed",
    "db:diff": "supabase db diff --linked",
    "db:types": "supabase gen types typescript --linked > packages/data/src/database.types.ts",
    "db:DANGER:reset": "supabase db reset --linked"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "supabase": "2.113.0",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  },
  "overridesReason": "React Native needs exactly one React instance per app. Dozens of Expo packages declare react as a wildcard peer, so npm also hoists a newest-wins copy to the root for them. These overrides keep any transitively-installed React on the version Expo SDK 57 was tested against; each app additionally pins its own, which is what Metro and Vite actually resolve.",
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@types/react": "19.2.2"
  },
  "packageManager": "npm@11.6.2"
}
