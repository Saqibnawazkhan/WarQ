# Repository-level ignores.
#
# The Flutter app under mobile/ has its own .gitignore; these rules are a
# safety net so build output (multiple GB) can never be committed from the
# repository root, whatever directory a tool runs in.

# Dart / Flutter
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/generated_plugin_registrant.dart
*.g.dart.lock

# Android
**/.gradle/
**/local.properties
**/captures/
**/*.keystore
**/*.jks
**/key.properties
**/.cxx/

# iOS / macOS
**/Pods/
**/.symlinks/
**/Flutter/Flutter.framework
**/Flutter/Flutter.podspec
**/Flutter/App.framework
**/Flutter/ephemeral/
**/ServiceDefinitions.json
**/xcuserdata/
**/*.mode1v3
**/*.mode2v3
**/*.perspectivev3

# Editors
.idea/
.vscode/
*.iml
*.ipr
*.iws
.history/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs and temp
*.log
*.tmp
coverage/

# Secrets — never commit credentials
.env
.env.*
!.env.example
