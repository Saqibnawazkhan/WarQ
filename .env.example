# Warq — environment reference.
#
# Copy to `.env` and fill in. Never commit the filled copy: `.env` is ignored.
# Real values live in Vercel, Railway and Expo, not in the repository.
#
# Warq uses Supabase's current API keys (`sb_publishable_…` / `sb_secret_…`),
# not the deprecated JWT pair (`anon` / `service_role`). See docs/SUPABASE-SETUP.md.

# ─────────────────────────────────────────────────────────────
# Supabase — the single source of truth (from M1)
# ─────────────────────────────────────────────────────────────

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Publishable key — `sb_publishable_…`
# Safe in a browser or a phone: every request it makes is still filtered by
# row-level security. It ships inside the web bundle and the mobile app.
SUPABASE_PUBLISHABLE_KEY=

# Secret key — `sb_secret_…`
# Bypasses row-level security entirely.
# Worker only — never in the web app, never in the mobile app, never in CI logs.
SUPABASE_SECRET_KEY=


# ─────────────────────────────────────────────────────────────
# Web app (apps/web) — Vite exposes only VITE_-prefixed variables
# ─────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=


# ─────────────────────────────────────────────────────────────
# Mobile app (apps/mobile) — Expo exposes only EXPO_PUBLIC_-prefixed variables
# ─────────────────────────────────────────────────────────────

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ─────────────────────────────────────────────────────────────
# Worker (apps/worker)
# ─────────────────────────────────────────────────────────────

# Railway injects PORT. 8080 locally.
PORT=8080
HOST=0.0.0.0
NODE_ENV=development


# ─────────────────────────────────────────────────────────────
# Notification channels (from M7)
# ─────────────────────────────────────────────────────────────

# Leave blank in development: the worker falls back to a log-only adapter,
# so a test run can never message a real parent.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
